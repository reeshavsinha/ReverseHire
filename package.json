{
  "name": "reversehire",
  "private": true,
  "version": "1.0.0",
  "description": "ReverseHire - a reverse recruitment platform MVP",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run start --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
